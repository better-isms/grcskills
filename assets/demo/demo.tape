# Renders assets/demo/demo.gif from the recorded run. From the repo root:
#   vhs assets/demo/demo.tape
Output assets/demo/demo.gif
Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 14
Set Width 1100
Set Height 760
Set Padding 28
Set Framerate 12
Set PlaybackSpeed 1.0
Set TypingSpeed 0ms
Set Theme { "name": "grcskills", "background": "#0f172a", "foreground": "#e2e8f0", "cursor": "#0f172a", "selection": "#334155", "black": "#0f172a", "red": "#f87171", "green": "#4ade80", "yellow": "#fbbf24", "blue": "#93c5fd", "magenta": "#c4b5fd", "cyan": "#7dd3fc", "white": "#e2e8f0", "brightBlack": "#64748b", "brightRed": "#fca5a5", "brightGreen": "#86efac", "brightYellow": "#fde68a", "brightBlue": "#bfdbfe", "brightMagenta": "#ddd6fe", "brightCyan": "#bae6fd", "brightWhite": "#f8fafc" }
Hide
Type "clear && node assets/demo/replay.mjs" Enter
Sleep 2.6s
Show
Sleep 16.5s
