{
  "name": "grcskills-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "npm run content && next dev -p 3123",
    "build": "npm run content && next build && node scripts/postbuild.mjs",
    "serve": "node scripts/serve.mjs out 4321",
    "test": "node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "seo:gate": "node scripts/seo-gate.mjs build out --config seo-gate.config.json --level L0P"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "markdown-it": "15.0.2",
    "next": "16.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/markdown-it": "14.2.0",
    "@types/node": "20.19.35",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "satori": "0.35.0",
    "typescript": "5.9.3"
  }
}
